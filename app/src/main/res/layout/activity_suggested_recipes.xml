<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#10251D"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SUGGESTED RECIPES"
        android:textColor="#D4B879"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:paddingBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meals you can make"
        android:textColor="#F4F0E4"
        android:textSize="27sp"
        android:textStyle="bold"
        android:paddingBottom="14dp" />

    <Button
        android:id="@+id/btnBackToHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@null"
        android:layout_marginTop="12dp"
        android:text="← Home"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/txtNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No complete recipe matches yet. Add more ingredients to your pantry."
        android:textColor="#B9CBAF"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/recipeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp" />
    </ScrollView>

</LinearLayout>
