<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10251D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY"
            android:textColor="#D4B879"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add Ingredient"
            android:textColor="#F4F0E4"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Record what you have in your kitchen."
            android:textColor="#B9CBAF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Ingredient name"
            android:textColor="#F4F0E4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etIngredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D4B879"
            android:hint="e.g. Tomatoes"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="#F4F0E4"
            android:textColorHint="#B9CBAF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quantity"
            android:textColor="#F4F0E4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etIngredientQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D4B879"
            android:hint="e.g. 6"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#F4F0E4"
            android:textColorHint="#B9CBAF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Unit"
            android:textColor="#F4F0E4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerIngredientUnit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D4B879"
            android:entries="@array/ingredient_units"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="#D4B879"
            android:text="Save Ingredient"
            android:textAllCaps="false"
            android:textColor="#10251D"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCancelIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1C382B"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#F4F0E4"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
