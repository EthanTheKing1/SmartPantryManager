<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Ingredient image and details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgIngredient"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Ingredient image"
            android:scaleType="centerCrop"
            android:background="#10251D" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIngredientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F4F0E4"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIngredientQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#B9CBAF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvIngredientExpiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D4B879"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Existing Edit and Delete buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditIngredient"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#F4F0E4" />

        <Button
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="#F4F0E4" />

    </LinearLayout>

</LinearLayout>
