<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10251D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <Button
            android:id="@+id/btnBackToRecipes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Recipes"
            android:textAllCaps="false" />

        <ImageView
            android:id="@+id/imgRecipeDetail"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="18dp"
            android:contentDescription="Recipe image"
            android:scaleType="centerCrop"
            android:background="#1C382B" />


        <TextView
            android:id="@+id/txtRecipeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe name"
            android:textColor="#D4B879"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INGREDIENTS"
            android:textColor="#D4B879"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:id="@+id/detailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C382B"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PREPARATION"
            android:textColor="#D4B879"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingTop="24dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/txtPreparationSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F4F0E4"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:paddingBottom="24dp" />

    </LinearLayout>
</ScrollView>
