<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10251D"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S M A R T   P A N T R Y"
            android:textColor="#B9CBAF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Your kitchen,"
            android:textColor="#F4F0E4"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="beautifully organised."
            android:textColor="#D4B879"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:text="Know what you have. Discover what you can make."
            android:textColor="#B9CBAF"
            android:textSize="15sp" />

        <!-- Pantry card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#1C382B">

            <ImageView
                android:id="@+id/imgHomePantry"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="18dp"
                android:contentDescription="Fresh pantry ingredients"
                android:scaleType="centerCrop"
                android:src="@drawable/home_pantry" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR KITCHEN INVENTORY"
                android:textColor="#D4B879"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your pantry, at a glance."
                android:textColor="#F4F0E4"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:text="Keep your ingredients organised and ready for your next meal."
                android:textColor="#B9CBAF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPantry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@null"
                android:text="VIEW MY PANTRY  →"
                android:textColor="#10251D"
                android:textStyle="bold"
                android:minHeight="52dp"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Recipe section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Make something good."
            android:textColor="#F4F0E4"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Recipes that work with what you already have."
            android:textColor="#B9CBAF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgHomeRecipes"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="Open cookbook surrounded by ingredients"
            android:scaleType="centerCrop"
            android:src="@drawable/home_recipes" />

        <Button
            android:id="@+id/btnRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@null"
            android:text="EXPLORE RECIPES  →"
            android:textColor="#F4F0E4"
            android:textStyle="bold"
            android:minHeight="56dp"
            android:textAllCaps="false" />

        <!-- Settings section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personalise your experience"
                android:textColor="#F4F0E4"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:text="Manage your app preferences."
                android:textColor="#B9CBAF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@null"
                android:text="OPEN SETTINGS"
                android:textColor="#D4B879"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="LESS WASTE. MORE GOOD FOOD."
            android:textColor="#78917F"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

</ScrollView>
